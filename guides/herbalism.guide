  goto 47.7,37.8 "Wilted Peacebloom, Stunted Silverleaf" r 30
  goto 46.0,32.0 "Wilted Peacebloom, Stunted Silverleaf" r 30
  goto 51.6,32.9 "Wilted Peacebloom, Stunted Silverleaf" r 30
  goto 50.8,83.4 "Earthroot" r 30
  goto 78.5,76.4 "Silverleaf, Peacebloom" r 30
  goto 23.0,76.6 "Silverleaf, Peacebloom" r 30
