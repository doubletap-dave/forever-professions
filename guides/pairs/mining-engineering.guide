  goto 61.0,66.2 "Mithril Deposit, Truesilver Deposit" r 30
  goto 52.3,64.9 "Mithril Deposit, Truesilver Deposit" r 30
  goto 50.3,71.1 "Mithril Deposit, Truesilver Deposit" r 30
  goto 23.4,61.0 "Small Thorium Vein, Truesilver Deposit" r 30
  goto 32.9,49.2 "Mithril Deposit, Truesilver Deposit" r 30
