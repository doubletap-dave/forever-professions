  goto 50.1,71.6 "Mithril Deposit, Truesilver Deposit" r 30
  goto 52.4,59.7 "Mithril Deposit, Truesilver Deposit" r 30
  goto 50.0,48.2 "Mithril Deposit, Truesilver Deposit" r 30
  goto 39.0,49.8 "Mithril Deposit, Truesilver Deposit" r 30
  goto 33.5,41.2 "Mithril Deposit, Truesilver Deposit" r 30
  goto 46.9,33.4 "Mithril Deposit, Truesilver Deposit" r 30
  goto 55.2,84.9 "Mithril Deposit, Truesilver Deposit" r 30
